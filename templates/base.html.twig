<!DOCTYPE html>
<html lang="{{app.locale}}" translate="yes">
<head>
   <title>{% block title %} Bienvenue chez {{NAME_SITE}} {% endblock %}</title>
   {% set  current_page_url = absolute_url(app.request.attributes.get('_route'), app.request.attributes.get('_route_params'))  %}
   {% block head %}
     {% block meta %}
          <meta charset="UTF-8">
          <meta name="robots" content="index, follow">
          <meta name="viewport" content="width=device-width, initial-scale=1  maximum-scale=1, user-scalable=no">
          <meta name="iws-config" content="{{ {
                          DEBUG: app.debug ?? false,
                          APP_ENV: app.environment ?? 'prod',
                          LOCALE: app.locale ?? 'fr',
                          ENABLE_LOCALE: app.enabled_locales ?? []
                      }|json_encode()|e('html_attr') }}">
          <meta name="iws-translations" content="{{ {
                          submitButton: 'submitButton'|trans({},"formSubmitHandler",app.locale),
                           messageBeforeSendData_title: "messageBeforeSendData.title"|trans({},"formSubmitHandler",app.locale),
                          messageBeforeSendData_content: "messageBeforeSendData.content"|trans({},"formSubmitHandler",app.locale)
                      }|json_encode()|e('html_attr') }}">
          {% if app.environment =="prod" %}
              <meta property="og:image" content="{% block og_image %} {{asset('img/logo.svg')}} {% endblock %}">
            <meta name="google-site-verification" content="_hEd8X5kXmy6ycu5uQkrlIlCMMyrEbJXJbChr6aqIsg">
            <meta name="google-site-verification" content="t0KDBpGkviLSxUksZVOn4FIJdmLcY4pEusLrQlnYhrg">
             <meta name="description" content="{% block meta_description %} {% endblock %}">
            <meta name="keywords" content="{% block meta_keywords %}{% endblock %}">
            {% block meta_opengraph %}
               <meta property="og:title" content="{% block og_title %} {{block('title')}} {% endblock %}">
               <meta property="og:type" content="website">
               <meta name="twitter:title" content="{% block twitter_title %} {{block('title')}}{% endblock %}">
               <meta name="twitter:image" content="{% block twitter_image %}{{block('og_image')}}{% endblock %}">
              <meta property="og:url" content="{{ current_page_url }}">
              <meta property="og:description" content="{{ block('meta_description') }}">
            {% endblock %}
        {% endif %}
        {% endblock %}
      {% block link %}
          <link rel="canonical" href="{{ current_page_url }}">
          {% block cdn_link %}
                {% include 'link.html.twig' %}
          {% endblock %}
      {% endblock %}
       {% block javascripts %}
          {% block cdn_script %}
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js"
                integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO" crossorigin="anonymous">
            </script>
            <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js" integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g==" 
            crossorigin="anonymous" referrerpolicy="no-referrer">
          </script>
            <script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js" 
                integrity="sha512-bPs7Ae6pVvhOSiIcyUClR7/q2OAsRiovw4vAkX+zJbw3ShAeeqezq50RIIcIURq7Oa20rW2n2q+fyXBNcU9lrw==" 
                crossorigin="anonymous" referrerpolicy="no-referrer">
           </script>
          {% endblock %}
       {% block importmap %}{{ importmap('app') }}{% endblock %}
          {% if app.environment =="prod" %} 
            <script async src="https://www.googletagmanager.com/gtag/js?id=G-Z0YE1H6WX6"></script>
            <script>
                window.dataLayer = window.dataLayer || [];
                function gtag(){dataLayer.push(arguments);}
                gtag('js', new Date());
                gtag('config', 'G-Z0YE1H6WX6');
            </script>
            {% block json_ld_schema %} {{ include('schema.html.twig',{content_title:block('title')}) }}{% endblock %}
      {% endif %}
      {% endblock %}
   {% endblock %}
</head>
<body class="bg-light">
   {% set currentRoute = app.current_route %}
    {% set currentRouteParams = app.current_route_parameters %}
    {% set currentLocale = app.locale %}
    {% set availableLocales = AVAILABLE_LOCALES|split(',') %}

    {% include 'header.html.twig' %}

    {% block body %}{% endblock %}
    {% include "footer.html.twig" %}
    {% include 'script.html.twig' %}
     <script>
        AOS.init({
                once: false,
                startEvent: 'DOMContentLoaded'
        });
        AOS.refresh();
    </script>
</body>
</html>