{% extends 'base.html.twig' %}
{% block title %}Contactez un conseiller en crédit à la consommation{% endblock %}
{% block meta_description %}
      Besoin d’un conseil sur un crédit ? Échangez avec un expert pour obtenir un prêt adapté à votre situation personnelle ou professionnelle.
{% endblock %}
{% block meta_keywords %}
conseiller crédit consommation, prêt personnel, crédit professionnel, contact crédit, financement sur mesure
{% endblock %}
{% block body %}
    <section class="contact-hero-section position-relative text-white d-flex align-items-center justify-content-center">
    <video autoplay muted loop playsinline class="background-video" poster="{{asset('img/img14.jpg')}}">
        <source src="{{asset('video/video8.mp4')}}" type="video/mp4">
        Votre navigateur ne supporte pas les vidéos HTML5.
    </video>

    <div class="overlay position-absolute w-100 h-100"></div> 

    <div class="container text-center py-5 position-relative z-index-content"> 
        <div class="row justify-content-center">
            <div class="col-lg-10 col-md-11">
                <h1 class="display-3 fw-bold mb-3"
                    data-aos="fade-up"
                    data-aos-duration="1000"> 
                   {{ "contact.h1" |trans([],"ContactForm",app.locale)|raw }}
                </h1>
                <p class="lead mb-4 px-3"
                   data-aos="fade-up"
                   data-aos-duration="1200"
                   data-aos-delay="200">
                    {{ "contact.p" |trans([],"ContactForm",app.locale)|raw }}
                </p>
                <div data-aos="fade-up" data-aos-duration="1400" data-aos-delay="400">
                    <a href="#contact-form-section" class="btn btn-outline-light btn-lg rounded-pill px-4 py-2 fw-bold me-3">
                       {{ "contactFormSectionAnchor" |trans([],"ContactForm",app.locale)|raw }} <i class="fas fa-arrow-down ms-2"></i>
                    </a>
                    <a href="#contact-info-section" class="btn btn-primary-custom btn-lg rounded-pill px-4 py-2 fw-bold">
                           {{ "contactInfoSectionAnchor" |trans([],"ContactForm",app.locale)|raw }} ! <i class="fas fa-phone-alt ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

    <section id="contact-form-section" class="contact-form-section py-5 bg-white" data-turbo="true">
        <div class="container py-md-5">
            <div class="row justify-content-center mb-5 text-center">
                <div class="col-lg-8">
                    <h2 class="fs-2 fw-bold mb-3"
                        data-aos="fade-up"
                        data-aos-duration="1000">
                         {{ "contactFormSection.h2" |trans([],"ContactForm",app.locale)|raw }}
                    </h2>
                    <p class="lead text-muted"
                       data-aos="fade-up"
                       data-aos-duration="1200" 
                       data-aos-delay="200">
                        {{ "contactFormSection.p" |trans([],"ContactForm",app.locale)|raw }}
                    </p>
                </div>
            </div>
            <div class="row justify-content-center">
                <div class="col-lg-8 col-md-10"
                     data-aos="fade-up"
                     data-aos-duration="1000"
                     data-aos-delay="300">
                    <div class="contact-form-wrapper p-4 p-md-5 rounded-3 shadow-lg bg-light" data-turbo="true">
                        {{ form_start(form, { attr: { 'data-turbo-submits-without-reload':"true",class: 'form-validate', id: form.vars.name, role: 'form'}}) }}
                              <div class="mb-3">
                                {{ form_row(form.fullname) }}
                            </div>
                            <div class="mb-3">
                                {{ form_row(form.email) }}
                            </div>
                            <div class="mb-3">
                                {{ form_row(form.phone) }}
                            </div>
                            <div class="mb-3">
                                {{ form_row(form.subject) }}
                            </div>
                            <div class="mb-4">
                                {{ form_row(form.content) }}
                            </div>
                             <button type="submit" class="btn btn-primary-custom btn-lg fw-bold rounded-pill px-5">
                                {{ 'btn.submit' |trans([],domain ='ContactForm', locale = app.request.locale) }}<i class="fas fa-paper-plane ms-2"></i>
                            </button>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="contact-info-section py-5 bg-light-subtle" id="contact-info-section">
        <div class="container py-md-5">
            <div class="row justify-content-center mb-5 text-center">
                <div class="col-lg-8">
                    <h2 class="fs-2 fw-bold mb-3"
                        data-aos="fade-up"
                        data-aos-duration="1000">
                         {{ "contactInfoSection.h2" |trans([],"ContactForm",app.locale)|raw }}
                    </h2>
                    <p class="lead text-muted"
                       data-aos="fade-up"
                       data-aos-duration="1200"
                       data-aos-delay="200">
                          {{ "contactInfoSection.p" |trans([],"ContactForm",app.locale)|raw }}
                    </p>
                </div>
            </div>
            <div class="row justify-content-center">
                <div class="col-lg-6 col-md-8"
                     data-aos="fade-up"
                     data-aos-duration="1000"
                     data-aos-delay="300">
                    <div class="contact-info-wrapper p-4 p-md-5 rounded-3 shadow-sm bg-white d-flex flex-column">
                        <div class="info-item mb-4 d-flex align-items-center">
                            <i class="fas fa-map-marker-alt fa-2x text-primary-custom me-3"></i>
                            <div>
                                <h4 class="h6 fw-bold mb-0"> {{ "contactInfoWrapper.address.title" |trans([],"ContactForm",app.locale) }}</h4>
                                <p class="mb-0 text-muted">{{ "contactInfoWrapper.address.content" |trans([],"ContactForm",app.locale) }}</p>
                            </div>
                        </div>

                        <div class="info-item mb-4 d-flex align-items-center">
                            <i class="fas fa-phone-alt fa-2x text-primary-custom me-3"></i>
                            <div>
                                <h4 class="h6 fw-bold mb-0">{{ "contactInfoWrapper.phone" |trans([],"ContactForm",app.locale) }} :</h4>
                                <p class="mb-0 text-muted"><a href="tel:{{PHONE_ADMIN}}" class="text-decoration-none text-muted">{{PHONE_ADMIN}}</a></p><br>
                                <p class="mb-0 text-muted"><a href="tel:{{PHONE_ADMIN_2}}" class="text-decoration-none text-muted">{{PHONE_ADMIN_2}}</a></p>
                            </div>
                        </div>

                        <div class="info-item mb-4 d-flex align-items-center">
                            <i class="fas fa-envelope fa-2x text-primary-custom me-3"></i>
                            <div>
                                <h4 class="h6 fw-bold mb-0">{{ "contactInfoWrapper.email" |trans([],"ContactForm",app.locale) }} :</h4>
                                <p class="mb-0 text-muted"><a href="mailto:{{EMAIL_ADMIN}}" class="text-decoration-none text-muted">{{EMAIL_ADMIN}}</a></p>
                            </div>
                        </div>

                        <div class="info-item mb-4 d-flex align-items-center">
                            <i class="fas fa-clock fa-2x text-primary-custom me-3"></i>
                            <div>
                                <h4 class="h6 fw-bold mb-0">{{ "horaire" |trans([],"footer",app.locale) }} :</h4>
                                <p class="mb-0 text-muted">{{ "lun.ven" |trans([],"footer",app.locale) }}: 8:30 à 18:00 pm</p>
                                <p class="mb-0 text-muted">{{ "sam" |trans([],"footer",app.locale) }}:9:30 à 13:00 pm</p>
                                 <p class="mb-0 text-muted">{{ "dim" |trans([],"footer",app.locale) }}:~</p>
                            </div>
                        </div>

                        <div class="map-container mt-4">
                            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2624.770857313019!2d2.348612115674393!3d48.856614079287315!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47e66e1f0e428e57%3A0x7d0b3f5e5b3f5b3f!2sParis%2C%20France!5e0!3m2!1sen!2sfr!4v1625078400000!5m2!1sen!2sfr" width="100%" height="250" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}