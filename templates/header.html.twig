<header>
    <nav class="navbar navbar-expand-lg">
       <div class="container-fluid d-flex justify-content-between align-items-center">
          <a class="navbar-brand aos-item  d-flex align-items-center" 
              href="{{ path('home') }}"
              data-aos="fade-right"
            data-aos-duration="2000"
            data-aos-delay="500"
              >
          <img src="{{ asset('img/LOGO5.jpg') }}" alt="{{ NAME_SITE }}" 
              class="d-block img-fluid me-2 logo-glow logo-img" height="50" width="50">
            <p class="d-flex flex-column">
               <span class="logo-animated" id="name_first">{{ NAME_FIRST }}</span>
               <span class="logo-animated" id="name_second">{{ NAME_SECOND }}</span>
            </p>
        </a>

          <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
           data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon text-white" style="color:#ffff;"></span>
          </button>
          <div class="collapse navbar-collapse justify-content-end aos-item navigation-link"
          data-aos="fade-left"
           data-aos-duration="2000"
            data-aos-delay="500"
                data-aos-once="false"
           id="navbarSupportedContent">
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0 navigation">
              <li class="nav-item">
                <a class="nav-link" href="{{path('home')}}">{{ 'home' |trans(arguments = [], domain = "header", locale = app.locale) }}</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="{{path('about')}}">{{ 'about' |trans(arguments = [], domain = "header", locale = app.locale) }}</a>
              </li>
               <li class="nav-item">
                <a class="nav-link"   href="{{path('services.home')}}">{{ 'services.home' |trans(arguments = [], domain = "header", locale = app.locale) }}</a>
              </li>
              <li class="nav-item">
                <a class="nav-link"  href="{{path('contact.form.us')}}">{{ 'contact.form.us' |trans(arguments = [], domain = "header", locale = app.locale) }}</a>
              </li>
              <li class="nav-item">
                <a class="nav-link"   href="{{path('loan.application.credit')}}">{{ 'loan.application.credit' |trans(arguments = [], domain = "header", locale = app.locale) }}</a>
              </li>
            </ul>
            <div class="navbar-nav ms-3 mb-2 mb-lg-0">
            <div class="nav-item dropdown no-translate" translate="no">

                <a class="nav-link text-color-primary text-color-hover-dark dropdown-toggle" 
                    href="#" role="button" id="dropdownLanguage"
                   data-bs-toggle="dropdown" aria-haspopup="true"  aria-expanded="false">
                    {% if currentLocale =="en" %}
                        {% set currentLocale = "gb" %}
                     {% endif %}
                  <i class="flag flag-icon flag-icon-{{ currentLocale }}"></i>
                  <span class="text-uppercase">{{ currentLocale }}</span>
                  <i class="fas fa-angle-down"></i>
                </a>
                <div class="dropdown-menu dropdown-menu-end min-width-0" aria-labelledby="dropdownLanguage">
                    {% for locale in availableLocales %}
                     {% set displayLocale = (locale == 'en') ? 'gb' : locale %}
                {% set targetRouteParams = currentRouteParams|merge({'_locale': locale}) %}
                <a class="dropdown-item language-switcher" 
                   hreflang="{{ displayLocale }}" 
                   href="{{ path(currentRoute, targetRouteParams) }}" 
                   data-lang="{{ displayLocale }}" 
                   title="{{ displayLocale|trans({}, 'lang',currentLocale) }}">
                    <i class="flag flag-icon flag-icon-{{ displayLocale }}"></i>
                    <span class="text-capitalize">{{ displayLocale |trans({}, 'lang',currentLocale) }}</span>
                </a>
            {% endfor %}
                </div>
            </div>
        </div>
          </div>
       </div>
    </nav>
  </header>