                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm border-0 bg-light-blue">
                            <div class="card-body text-center">
                                <i class="fas fa-home fa-3x text-primary-dark mb-3"></i>
                                <h5 class="card-title text-primary-dark">Primeros Compradores</h5>
                                <p class="card-text text-secondary-dark">Para la compra de su residencia principal.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm border-0 bg-light-blue">
                            <div class="card-body text-center">
                                <i class="fas fa-city fa-3x text-primary-dark mb-3"></i>
                                <h5 class="card-title text-primary-dark">Inversores de Alquiler</h5>
                                <p class="card-text text-secondary-dark">Financiación de propiedades para alquiler.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm border-0 bg-light-blue">
                            <div class="card-body text-center">
                                <i class="fas fa-wrench fa-3x text-primary-dark mb-3"></i>
                                <h5 class="card-title text-primary-dark">Proyectos de Renovación</h5>
                                <p class="card-text text-secondary-dark">Mejore o amplíe su patrimonio.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-5" data-aos="fade-up" data-aos-duration="1000">
