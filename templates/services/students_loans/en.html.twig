{% extends 'base.html.twig' %}
{% block title %}Student loan: advantageous rates and simple procedures{% endblock %}
{% block meta_description %}
      Finance your studies with a student loan at a preferential rate. Quick application, deferred repayment possible, no hidden fees.
{% endblock %}
{% block meta_keywords %}
student loan
{% endblock %}
{% block body %}
    <main class="professional-loan">
    <section class="hero-section hero-etudiant text-white d-flex align-items-center justify-content-center text-center">
    <div class="container" data-aos="fade-up" data-aos-duration="1000">
        <h1 class="display-3 fw-bold">Student Loans</h1>
        <p class="lead mt-3">Financing for your higher education, tuition fees, or housing.</p>
        <a href="#details" class="btn btn-primary-custom btn-lg mt-4">Learn more</a>
    </div>
</section>

<section id="introduction" class="py-5 bg-light-blue">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-md-12 text-center" data-aos="fade-up" data-aos-duration="1000">
                <h2 class="section-title text-primary-dark mb-4">Understanding Student Loans</h2>
                <p class="lead text-secondary-dark">
                    Pursuing higher education is a major investment in your future. However, tuition fees, housing, educational materials, and daily expenses can be a barrier. The <strong>Student Loan</strong> is a financing solution specifically designed to allow you to fully focus on your studies without worrying about financial constraints. At <strong>{{NAME_SITE}}</strong>, we help you find the student loan that fits your needs so that your study project becomes an accessible reality.
                </p>
            </div>
        </div>
    </div>
</section>
<section id="details" class="py-5 bg-white">
    <div class="container">
        <div class="row mb-5" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="200">
            <div class="col-lg-10 col-md-12 mx-auto">
                <h2 class="section-title text-primary-dark mb-4 text-center">Our Approach to Student Loans</h2>
            </div>
        </div>

        <div class="row align-items-center mb-5 feature-row" data-aos="fade-right" data-aos-duration="1000">
            <div class="col-md-6 order-md-2" data-aos="fade-left" data-aos-duration="1000">
                <div class="ratio ratio-16x9 video-container shadow-sm rounded">
                    <img src="{{asset('img/img22.jpg')}}"
                         loading="lazy"
                           class="w-100 img-fluid h-100 rounded shadow-sm object-fit-cover">
                </div>
            </div>
            <div class="col-md-6 order-md-1">
                <h3 class="feature-title text-accent-red mb-3">What exactly is a Student Loan?</h3>
                <p class="text-secondary-dark">
                    A <strong>Student Loan</strong> is a bank loan specifically designed for students enrolled in higher education. It allows for the financing of a wide variety of study-related expenses, such as tuition fees (universities, colleges), the purchase of educational materials (computers, books), housing costs (rent, security deposit), transportation, or even daily expenses. Repayment terms are generally very advantageous, with a possible deferred repayment period during the duration of studies and a grace period, which eases the immediate financial burden.
                </p>
            </div>
        </div>

        <div class="row align-items-center mb-5 feature-row" data-aos="fade-left" data-aos-duration="1000">
            <div class="col-md-6">
               <div class="ratio ratio-16x9 video-container shadow-sm rounded"> <img src="{{asset('img/img23.jpg')}}" class="w-100 img-fluid h-100 rounded shadow-sm object-fit-cover" alt="Illustration Student Revising"></div>
            </div>
            <div class="col-md-6">
                <h3 class="feature-title text-accent-red mb-3">Why choose {{NAME_SITE}} for your Student Loan?</h3>
                <p class="text-secondary-dark">
                    We are your ideal partner for serene study financing:
                </p>
                <ul class="list-unstyled">
                    <li class="mb-2"><i class="fas fa-check-circle text-primary-dark me-2"></i> **Advantageous Conditions:** Competitive rates and flexible repayment terms (total or partial deferral).</li>
                    <li class="mb-2"><i class="fas fa-check-circle text-primary-dark me-2"></i> **Simplicity and Speed:** A streamlined application process for quick access to funds.</li>
                    <li class="mb-2"><i class="fas fa-check-circle text-primary-dark me-2"></i> **Personalized Support:** Our advisors guide you every step of the way, from simulation to implementation.</li>
                    <li class="mb-2"><i class="fas fa-check-circle text-primary-dark me-2"></i> **Broad Coverage:** Financing adapted to different types of studies and needs.</li>
                    <li class="mb-2"><i class="fas fa-check-circle text-primary-dark me-2"></i> **Flexible Amount:** A loan that can be adjusted according to the actual cost of your studies and expenses.</li>
                </ul>
            </div>
        </div>

        <div class="row mb-5" data-aos="fade-up" data-aos-duration="1000">
            <div class="col-lg-10 mx-auto text-center">
                <h3 class="feature-title text-accent-red mb-4">Who is this service for?</h3>
                <div class="row g-4 justify-content-center">
                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm border-0 bg-light-blue">
                            <div class="card-body text-center">
                                <i class="fas fa-user-graduate fa-3x text-primary-dark mb-3"></i>
                                <h5 class="card-title text-primary-dark">Post-Secondary Students</h5>
                                <p class="card-text text-secondary-dark">Universities, vocational schools, preparatory classes.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm border-0 bg-light-blue">
                            <div class="card-body text-center">
                                <i class="fas fa-university fa-3x text-primary-dark mb-3"></i>
                                <h5 class="card-title text-primary-dark">Grandes Écoles (Elite Schools)</h5>
                                <p class="card-text text-secondary-dark">Business schools, engineering schools, specialized schools.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm border-0 bg-light-blue">
                            <div class="card-body text-center">
                                <i class="fas fa-globe-americas fa-3x text-primary-dark mb-3"></i>
                                <h5 class="card-title text-primary-dark">Studies Abroad</h5>
                                <p class="card-text text-secondary-dark">Financing for international curricula.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-5" data-aos="fade-up" data-aos-duration="1000">
            <div class="col-lg-10 mx-auto text-center">
                <h3 class="feature-title text-accent-red mb-4">How does it work? (Simplified Process)</h3>
                <div class="process-steps">
                    <div class="process-step" data-aos="zoom-in" data-aos-duration="800" data-aos-delay="100">
                        <div class="step-icon bg-primary-dark text-white"><i class="fas fa-1"></i></div>
                        <h5 class="step-title text-primary-dark">Assess Your Needs</h5>
                        <p class="text-secondary-dark">Estimate the costs of your studies and expenses.</p>
                    </div>
                    <div class="process-step" data-aos="zoom-in" data-aos-duration="800" data-aos-delay="200">
                        <div class="step-icon bg-primary-dark text-white"><i class="fas fa-2"></i></div>
                        <h5 class="step-title text-primary-dark">Online Application</h5>
                        <p class="text-secondary-dark">Submit your application via our form.</p>
                    </div>
                    <div class="process-step" data-aos="zoom-in" data-aos-duration="800" data-aos-delay="300">
                        <div class="step-icon bg-primary-dark text-white"><i class="fas fa-3"></i></div>
                        <h5 class="step-title text-primary-dark">Personalized Study</h5>
                        <p class="text-secondary-dark">Our experts analyze your situation and propose an offer.</p>
                    </div>
                    <div class="process-step" data-aos="zoom-in" data-aos-duration="800" data-aos-delay="400">
                        <div class="step-icon bg-primary-dark text-white"><i class="fas fa-4"></i></div>
                        <h5 class="step-title text-primary-dark">Contract Signing</h5>
                        <p class="text-secondary-dark">Formalization of the loan and repayment terms.</p>
                    </div>
                    <div class="process-step" data-aos="zoom-in" data-aos-duration="800" data-aos-delay="500">
                        <div class="step-icon bg-primary-dark text-white"><i class="fas fa-5"></i></div>
                        <h5 class="step-title text-primary-dark">Fund Disbursement</h5>
                        <p class="text-secondary-dark">Funds are made available to you for your needs.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row" data-aos="fade-up" data-aos-duration="1000">
            <div class="col-lg-10 mx-auto">
                <h3 class="feature-title text-accent-red mb-4 text-center">The benefits for you:</h3>
                <div class="row g-4">
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm border-0 bg-primary-dark text-white text-center p-3">
                            <div class="card-body">
                                <i class="fas fa-piggy-bank fa-2x mb-3 text-accent-red"></i>
                                <h5 class="card-title">Budget Control</h5>
                                <p class="card-text">Cover your study expenses without pressure on your savings.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm border-0 bg-light-blue text-primary-dark text-center p-3">
                            <div class="card-body">
                                <i class="fas fa-calendar-alt fa-2x mb-3 text-accent-red"></i>
                                <h5 class="card-title">Deferred Repayment</h5>
                                <p class="card-text">Start repaying after the end of your studies.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm border-0 bg-primary-dark text-white text-center p-3">
                            <div class="card-body">
                                <i class="fas fa-hand-holding-heart fa-2x mb-3 text-accent-red"></i>
                                <h5 class="card-title">Peace of Mind</h5>
                                <p class="card-text">Focus on your studies, we'll manage the financing.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm border-0 bg-light-blue text-primary-dark text-center p-3">
                            <div class="card-body">
                                <i class="fas fa-chart-line fa-2x mb-3 text-accent-red"></i>
                                <h5 class="card-title">Investment in the Future</h5>
                                <p class="card-text">Finance training that will open doors to your career.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm border-0 bg-primary-dark text-white text-center p-3">
                            <div class="card-body">
                                <i class="fas fa-check-circle fa-2x mb-3 text-accent-red"></i>
                                <h5 class="card-title">Simplicity</h5>
                                <p class="card-text">Clear procedures and end-to-end support.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<section class="cta-section bg-white text-center py-5">
    <div class="container" data-aos="zoom-in" data-aos-duration="1000">
        <h2 class="display-5 fw-bold text-primary-dark">Ready to invest in your future?</h2>
        <p class="lead mt-3 text-secondary-dark">Submit your student loan application and secure the success of your studies!</p>
        <a href="{{ path('loan.application.credit') }}" class="btn btn-secondary-custom btn-lg mt-4">Apply for a student loan</a>
    </div>
</section>
    </main>
{% endblock %}