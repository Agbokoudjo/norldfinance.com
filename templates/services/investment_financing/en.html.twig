{% extends 'base.html.twig' %}
{% block title %} Investment Financing - {{NAME_SITE}} {% endblock %}
{% block meta_description %}
    Discover our loan and financing services.
{% endblock %}
{% block meta_keywords %}
    business loan
{% endblock %}
{% block body %}
    <main class="professional-loan">
    <section class="hero-section hero-investissement text-white d-flex align-items-center justify-content-center text-center">
    <div class="container" data-aos="fade-up" data-aos-duration="1000">
        <h1 class="display-3 fw-bold">Investment Financing</h1>
        <p class="lead mt-3">Optimize your investments with tailored financial solutions.</p>
        <a href="#details" class="btn btn-primary-custom btn-lg mt-4">Learn More</a>
    </div>
</section>

<section id="introduction" class="py-5 bg-light-blue">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-md-12 text-center" data-aos="fade-up" data-aos-duration="1000">
                <h2 class="section-title text-primary-dark mb-4">Understanding Investment Financing</h2>
                <p class="lead text-secondary-dark">
                    Whether it's building wealth, preparing for retirement, growing your capital, or supporting a major economic project, investment is a crucial step. However, navigating complex financing options and optimizing your investments can be challenging. At <strong>{{NAME_SITE}}</strong>, we offer tailored <strong>investment financing</strong> solutions designed to maximize your returns and secure your long-term projects through expertise and personalized advice.
                </p>
            </div>
        </div>
    </div>
</section>
<section id="details" class="py-5 bg-white">
