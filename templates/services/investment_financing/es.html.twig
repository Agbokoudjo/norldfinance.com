                    <img src="{{asset('img/img25.jpg')}}" class="w-100 h-100 object-fit-cover">
                </div>
            </div>
            <div class="col-md-6">
                <h3 class="feature-title text-accent-red mb-3">¿Por qué elegir {{NAME_SITE}} para tus Financiaciones de Inversión?</h3>
