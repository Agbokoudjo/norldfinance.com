                <div class="process-steps">
                    <div class="process-step" data-aos="zoom-in" data-aos-duration="800" data-aos-delay="100">
                        <div class="step-icon bg-primary-dark text-white"><i class="fas fa-1"></i></div>
                        <h5 class="step-title text-primary-dark">Análise de Objetivos</h5>
                        <p class="text-secondary-dark">Definição dos seus objetivos de investimento e do seu perfil.</p>
                    </div>
                    <div class="process-step" data-aos="zoom-in" data-aos-duration="800" data-aos-delay="200">
                        <div class="step-icon bg-primary-dark text-white"><i class="fas fa-2"></i></div>
                        <h5 class="step-title text-primary-dark">Estratégia Personalizada</h5>
                        <p class="text-secondary-dark">Elaboração de uma estratégia de financiamento adaptada.</p>
                    </div>
                    <div class="process-step" data-aos="zoom-in" data-aos-duration="800" data-aos-delay="300">
                        <div class="step-icon bg-primary-dark text-white"><i class="fas fa-3"></i></div>
                        <h5 class="step-title text-primary-dark">Busca de Soluções</h5>
                        <p class="text-secondary-dark">Identificação dos instrumentos e parceiros de financiamento.</p>
                    </div>
                    <div class="process-step" data-aos="zoom-in" data-aos-duration="800" data-aos-delay="400">
                        <div class="step-icon bg-primary-dark text-white"><i class="fas fa-4"></i></div>
                        <h5 class="step-title text-primary-dark">Implementação</h5>
                        <p class="text-secondary-dark">Acompanhamento na formalização e implantação.</p>
                    </div>
                    <div class="process-step" data-aos="zoom-in" data-aos-duration="800" data-aos-delay="500">
                        <div class="step-icon bg-primary-dark text-white"><i class="fas fa-5"></i></div>
                        <h5 class="step-title text-primary-dark">Monitoramento & Otimização</h5>
                        <p class="text-secondary-dark">Monitoramento regular e ajustes para maximizar os retornos.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row" data-aos="fade-up" data-aos-duration="1000">
            <div class="col-lg-10 mx-auto">
                <h3 class="feature-title text-accent-red mb-4 text-center">As vantagens para você:</h3>
                <div class="row g-4">
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm border-0 bg-primary-dark text-white text-center p-3">
                            <div class="card-body">
                                <i class="fas fa-chart-line fa-2x mb-3 text-accent-red"></i>
                                <h5 class="card-title">Crescimento Otimizado</h5>
                                <p class="card-text">Maximize o potencial de crescimento do seu capital.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4">
