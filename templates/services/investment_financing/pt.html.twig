                <div class="row g-4 justify-content-center">
                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm border-0 bg-light-blue">
                            <div class="card-body text-center">
                                <i class="fas fa-chart-pie fa-3x text-primary-dark mb-3"></i>
                                <h5 class="card-title text-primary-dark">Investidores Particulares</h5>
                                <p class="card-text text-secondary-dark">Para a gestão e o crescimento do seu patrimônio.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm border-0 bg-light-blue">
                            <div class="card-body text-center">
                                <i class="fas fa-building fa-3x text-primary-dark mb-3"></i>
                                <h5 class="card-title text-primary-dark">Empresas & Instituições</h5>
                                <p class="card-text text-secondary-dark">Financiamento de projetos, expansão, diversificação.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm border-0 bg-light-blue">
                            <div class="card-body text-center">
                                <i class="fas fa-user-tie fa-3x text-primary-dark mb-3"></i>
                                <h5 class="card-title text-primary-dark">Profissionais de Patrimônio</h5>
                                <p class="card-text text-secondary-dark">Soluções para seus clientes (consultores, gestores).</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

