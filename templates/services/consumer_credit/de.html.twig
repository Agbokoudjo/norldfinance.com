{% extends 'base.html.twig' %}
{% block title %} Verbraucherkredit: Simulation, Zinssätze und Bedingungen {% endblock %}
{% block meta_description %}
    Schnelle und flexible Finanzierung für Ihre persönlichen Bedürfnisse. Simulieren Sie einen Verbraucherkredit, der zu Ihrem Budget passt.
{% endblock %}
{% block meta_keywords %}
    Verbraucherkredit
{% endblock %}
{% block body %}
    <main class="professional-loan">
    <section class="hero-section hero-consommation text-white d-flex align-items-center justify-content-center text-center">
    <div class="container" data-aos="fade-up" data-aos-duration="1000">
        <h1 class="display-3 fw-bold">Konsumentenkredit</h1>
        <p class="lead mt-3">Finanzieren Sie Ihre persönlichen Projekte (Fahrzeug, Renovierung, Freizeit) mit flexiblen Lösungen.</p>
        <a href="#details" class="btn btn-primary-custom btn-lg mt-4">Mehr erfahren</a>
    </div>
</section>

<section id="introduction" class="py-5 bg-light-blue">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-md-12 text-center" data-aos="fade-up" data-aos-duration="1000">
                <h2 class="section-title text-primary-dark mb-4">Den Konsumentenkredit verstehen</h2>
                <p class="lead text-secondary-dark">
                    Reiselust, Renovierungsbedarf, der Kauf eines neuen Fahrzeugs oder Haushaltsgeräts? Der <strong>Konsumentenkredit</strong> ist die ideale Lösung, um Ihre persönlichen Projekte zu verwirklichen, ohne Ihre Ersparnisse zu belasten. Bei <strong>{{NAME_SITE}}</strong> bieten wir Ihnen flexible und maßgeschneiderte Konsumentenkredite, die Ihnen die Freiheit geben, Ihre Wünsche zu erfüllen und Ihren Alltag sorgenfrei zu verbessern.
                </p>
            </div>
        </div>
    </div>
</section>
<section id="details" class="py-5 bg-white">
    <div class="container">
        <div class="row mb-5" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="200">
            <div class="col-lg-10 col-md-12 mx-auto">
                <h2 class="section-title text-primary-dark mb-4 text-center">Unser Ansatz zum Verbraucherkredit</h2>
            </div>
        </div>

        <div class="row align-items-center mb-5 feature-row" data-aos="fade-right" data-aos-duration="1000">
            <div class="col-md-6 order-md-2" data-aos="fade-left" data-aos-duration="1000">
                <div class="ratio ratio-16x9 video-container shadow-sm rounded">
                    <video autoplay muted loop playsinline preload="metadata" 
                           poster="{{asset('img/img19.png')}}" 
                           class="w-100 h-100 object-fit-cover">
                        <source src="{{asset('video/video14.mp4')}}" type="video/mp4">
                        Ihr Browser unterstützt das Video-Tag nicht.
                    </video>
                </div>
            </div>
            <div class="col-md-6 order-md-1">
                <h3 class="feature-title text-accent-red mb-3">Was genau ist Verbraucherkredit?</h3>
                <p class="text-secondary-dark">
                    Der <strong>Verbraucherkredit</strong> ist ein Darlehen, das Privatpersonen zur Finanzierung des Kaufs von Konsumgütern oder Dienstleistungen gewährt wird, die keine Immobilien sind. Dies umfasst verschiedene Projekte wie den Kauf eines Autos, die <strong>Finanzierung von Renovierungsarbeiten</strong>, die Organisation von Reisen, Studien oder den Erwerb von Haushaltsgeräten. Er nimmt verschiedene Formen an (<strong>Privatdarlehen, zweckgebundenes Darlehen, revolvierender Kredit</strong>), und seine Merkmale (Betrag, Laufzeit, Zinssatz) sind an die Art Ihres Projekts und Ihre Rückzahlungsfähigkeit angepasst.
                </p>
            </div>
        </div>

        <div class="row align-items-center mb-5 feature-row" data-aos="fade-left" data-aos-duration="1000">
            <div class="col-md-6">
                <div class="ratio ratio-16x9 video-container shadow-sm rounded">
                    <video autoplay muted loop playsinline preload="metadata" 
                           poster="{{asset('img/img20.png')}}" 
                           class="w-100 h-100 object-fit-cover">
                        <source src="{{asset('video/video15.mp4')}}" type="video/mp4">
                        Ihr Browser unterstützt das Video-Tag nicht.
                    </video>
                </div>
            </div>
            <div class="col-md-6">
                <h3 class="feature-title text-accent-red mb-3">Warum {{NAME_SITE}} für Ihren Verbraucherkredit wählen?</h3>
                <p class="text-secondary-dark">
                    Die Wahl unserer Institution bedeutet Einfachheit, Schnelligkeit und Personalisierung:
                </p>
                <ul class="list-unstyled">
                    <li class="mb-2"><i class="fas fa-check-circle text-primary-dark me-2"></i> **Flexible Lösungen:** Darlehensangebote, die an Ihre Bedürfnisse und Ihr Budget angepasst sind.</li>
                    <li class="mb-2"><i class="fas fa-check-circle text-primary-dark me-2"></i> **Vereinfachte Verfahren:** Ein klarer und schneller Antragsপ্রzess für eine effiziente Auszahlung der Mittel.</li>
                    <li class="mb-2"><i class="fas fa-check-circle text-primary-dark me-2"></i> **Absolute Transparenz:** Keine versteckten Gebühren, alle Bedingungen sind klar erklärt.</li>
                    <li class="mb-2"><i class="fas fa-check-circle text-primary-dark me-2"></i> **Expertenberatung:** Unsere Berater stehen Ihnen zur Seite, um Sie zur besten Finanzierungsoption zu führen.</li>
                    <li class="mb-2"><i class="fas fa-check-circle text-primary-dark me-2"></i> **Schnelle Antwort:** Erhalten Sie eine schnelle Antwort auf Ihre Anfrage.</li>
                </ul>
            </div>
        </div>

        <div class="row mb-5" data-aos="fade-up" data-aos-duration="1000">
            <div class="col-lg-10 mx-auto text-center">
                <h3 class="feature-title text-accent-red mb-4">Für wen ist dieser Service gedacht?</h3>
                <div class="row g-4 justify-content-center">
                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm border-0 bg-light-blue">
                            <div class="card-body text-center">
                                <i class="fas fa-car fa-3x text-primary-dark mb-3"></i>
                                <h5 class="card-title text-primary-dark">Fahrzeugkauf</h5>
                                <p class="card-text text-secondary-dark">Finanzieren Sie ein Auto, ein Motorrad, etc.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm border-0 bg-light-blue">
                            <div class="card-body text-center">
                                <i class="fas fa-hammer fa-3x text-primary-dark mb-3"></i>
                                <h5 class="card-title">Arbeiten & Renovierungen</h5>
                                <p class="card-text text-secondary-dark">Renovieren, statten Sie Ihr Zuhause aus.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm border-0 bg-light-blue">
                            <div class="card-body text-center">
                                <i class="fas fa-plane fa-3x text-primary-dark mb-3"></i>
                                <h5 class="card-title">Reisen & Freizeit</h5>
                                <p class="card-text text-secondary-dark">Finanzieren Sie Urlaube, ein Hobby, Studien.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-5" data-aos="fade-up" data-aos-duration="1000">
            <div class="col-lg-10 mx-auto text-center">
                <h3 class="feature-title text-accent-red mb-4">Wie es funktioniert? (Vereinfachter Prozess)</h3>
                <div class="process-steps">
                    <div class="process-step" data-aos="zoom-in" data-aos-duration="800" data-aos-delay="100">
                        <div class="step-icon bg-primary-dark text-white"><i class="fas fa-1"></i></div>
                        <h5 class="step-title text-primary-dark">Ihr Projekt identifizieren</h5>
                        <p class="text-secondary-dark">Definieren Sie Ihren Finanzierungsbedarf klar.</p>
                    </div>
                    <div class="process-step" data-aos="zoom-in" data-aos-duration="800" data-aos-delay="200">
                        <div class="step-icon bg-primary-dark text-white"><i class="fas fa-2"></i></div>
                        <h5 class="step-title text-primary-dark">Online-Antrag</h5>
                        <p class="text-secondary-dark">Füllen Sie unser schnelles und sicheres Formular aus.</p>
                    </div>
                    <div class="process-step" data-aos="zoom-in" data-aos-duration="800" data-aos-delay="300">
                        <div class="step-icon bg-primary-dark text-white"><i class="fas fa-3"></i></div>
                        <h5 class="step-title text-primary-dark">Analyse & Vorschlag</h5>
                        <p class="text-secondary-dark">Wir prüfen Ihr Dossier und schlagen Ihnen das passende Angebot vor.</p>
                    </div>
                    <div class="process-step" data-aos="zoom-in" data-aos-duration="800" data-aos-delay="400">
                        <div class="step-icon bg-primary-dark text-white"><i class="fas fa-4"></i></div>
                        <h5 class="step-title text-primary-dark">Vertragsunterzeichnung</h5>
                        <p class="text-secondary-dark">Bestätigen Sie die Bedingungen und unterzeichnen Sie Ihren Darlehensvertrag.</p>
                    </div>
                    <div class="process-step" data-aos="zoom-in" data-aos-duration="800" data-aos-delay="500">
                        <div class="step-icon bg-primary-dark text-white"><i class="fas fa-5"></i></div>
                        <h5 class="step-title text-primary-dark">Mittel freigegeben</h5>
                        <p class="text-secondary-dark">Die Mittel werden Ihnen schnell zur Verfügung gestellt.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row" data-aos="fade-up" data-aos-duration="1000">
            <div class="col-lg-10 mx-auto">
                <h3 class="feature-title text-accent-red mb-4 text-center">Ihre Vorteile:</h3>
                <div class="row g-4">
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm border-0 bg-primary-dark text-white text-center p-3">
                            <div class="card-body">
                                <i class="fas fa-sliders-h fa-2x mb-3 text-accent-red"></i>
                                <h5 class="card-title">Flexibilität</h5>
                                <p class="card-text">Rückzahlungsoptionen, die an Ihre finanzielle Leistungsfähigkeit angepasst sind.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm border-0 bg-light-blue text-primary-dark text-center p-3">
                            <div class="card-body">
                                <i class="fas fa-hourglass-start fa-2x mb-3 text-accent-red"></i>
                                <h5 class="card-title">Schnelligkeit</h5>
                                <p class="card-text">Erhalten Sie schnell eine Antwort und die Mittel für Ihre dringenden Projekte.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm border-0 bg-primary-dark text-white text-center p-3">
                            <div class="card-body">
                                <i class="fas fa-shield-alt fa-2x mb-3 text-accent-red"></i>
                                <h5 class="card-title">Sicherheit</h5>
                                <p class="card-text">Ein klarer und transparenter Rahmen, ohne böse Überraschungen.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm border-0 bg-light-blue text-primary-dark text-center p-3">
                            <div class="card-body">
                                <i class="fas fa-user-friends fa-2x mb-3 text-accent-red"></i>
                                <h5 class="card-title">Begleitung</h5>
                                <p class="card-text">Unsere Experten beraten Sie für die beste Wahl.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm border-0 bg-primary-dark text-white text-center p-3">
                            <div class="card-body">
                                <i class="fas fa-piggy-bank fa-2x mb-3 text-accent-red"></i>
                                <h5 class="card-title">Einsparung von Ersparnissen</h5>
                                <p class="card-text">Verwirklichen Sie Ihre Projekte, ohne Ihre Ersparnisse anzutasten.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
    <section class="cta-section bg-white text-center py-5">
    <div class="container" data-aos="zoom-in" data-aos-duration="1000">
        <h2 class="display-5 fw-bold text-primary-dark">Ein persönliches Projekt im Kopf?</h2>
        <p class="lead mt-3 text-secondary-dark">Stellen Sie noch heute Ihren Antrag auf einen Verbraucherkredit und erhalten Sie eine schnelle Antwort!</p>
        <a href="{{ path('loan.application.credit') }}" class="btn btn-secondary-custom btn-lg mt-4">Verbraucherkredit beantragen</a>
    </div>
</section>
    </main>
{% endblock %}
