                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm border-0 bg-light-blue">
                            <div class="card-body text-center">
                                <i class="fas fa-chart-line-down fa-3x text-primary-dark mb-3"></i>
                                <h5 class="card-title text-primary-dark">Daling van Inkomen</h5>
                                <p class="card-text text-secondary-dark">In geval van een wijziging in de financiële situatie.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
