                <div class="row g-4 justify-content-center">
                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm border-0 bg-light-blue">
                            <div class="card-body text-center">
                                <i class="fas fa-money-check-alt fa-3x text-primary-dark mb-3"></i>
                                <h5 class="card-title text-primary-dark">Multi-loan Holders</h5>
                                <p class="card-text text-secondary-dark">Those who have several ongoing loans.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm border-0 bg-light-blue">
                            <div class="card-body text-center">
                                <i class="fas fa-chart-line-down fa-3x text-primary-dark mb-3"></i>
                                <h5 class="card-title text-primary-dark">Income Decrease</h5>
                                <p class="card-text text-secondary-dark">In case of a change in financial situation.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm border-0 bg-light-blue">
                            <div class="card-body text-center">
                                <i class="fas fa-lightbulb fa-3x text-primary-dark mb-3"></i>
                                <h5 class="card-title text-primary-dark">New Projects</h5>
