    </div>
</section>
<section class="cta-section bg-white text-center py-5">
    <div class="container" data-aos="zoom-in" data-aos-duration="1000">
        <h2 class="display-5 fw-bold text-primary-dark">Simplify your budget now!</h2>
        <p class="lead mt-3 text-secondary-dark">Contact our experts for a free and no-obligation loan buyback simulation.</p>
        <a href="{{ path('loan.application.credit') }}" class="btn btn-secondary-custom btn-lg mt-4">Request a loan buyback</a>
    </div>
</section>
</main>
