{% extends "base.html.twig" %}
{% block title %}Professional Loan for Businesses: Tailored Financing{% endblock %}
{% block meta_description %}
    Get professional financing tailored to your business. Investment, cash flow, or development: Concrete solutions.
{% endblock %}
{% block meta_keywords %}
business loan
{% endblock %}
{% block body %}
    <main class="professional-loan">
    <section class="hero-section text-white d-flex align-items-center justify-content-center text-center">
    <div class="container" data-aos="fade-up" data-aos-duration="1000">
        <h1 class="display-3 fw-bold">Professional Loan</h1>
        <p class="lead mt-3">Grow your business with financing solutions tailored to your specific needs.</p>
        <a href="#details" class="btn btn-primary-custom btn-lg mt-4">Learn more</a>
    </div>
</section>

<section id="introduction" class="py-5 bg-light-blue">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-md-12 text-center" data-aos="fade-up" data-aos-duration="1000">
                <h2 class="section-title text-primary-dark mb-4">Understanding the Professional Loan</h2>
                <p class="lead text-secondary-dark">
                    Financing is the engine of all business growth. Whether it’s acquiring new equipment, developing new markets, managing your working capital needs, or undertaking a major expansion project, quick and efficient access to capital is essential. At <span class="fw-bold">{{NAME_SITE}}</span>, we understand the unique challenges businesses face and offer <strong>Professional Loan</strong> solutions designed to support your ambition and accelerate your development, regardless of your business size or sector.
                </p>
            </div>
        </div>
    </div>
</section>
<section id="details" class="py-5 bg-white">
  <div class="container">
    <div class="row mb-5" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="200">
      <div class="col-lg-10 col-md-12 mx-auto">
        <h2 class="section-title text-primary-dark mb-4 text-center">Our Professional Loan Approach</h2>
      </div>
    </div>

    <div class="row align-items-center mb-5 feature-row" data-aos="fade-right" data-aos-duration="1000">
      <div class="col-md-6 order-md-2" data-aos="fade-left" data-aos-duration="1000">
        <div class="ratio ratio-16x9 video-container shadow-sm rounded">
          <video loading="lazy" autoplay muted loop playsinline preload="metadata" 
            poster="{{asset('img/img16.jpg')}}" class="img-fluid rounded">
            <source src="{{asset('video/video10.mp4')}}" type="video/mp4">
            Your browser does not support the video tag.
          </video>
        </div>
      </div>
      <div class="col-md-6 order-md-1">
        <h3 class="feature-title text-accent-red mb-3">What exactly is the Professional Loan?</h3>
        <p class="text-secondary-dark">
          The <strong>Professional Loan</strong> is a financing solution designed for businesses, associations, or sole proprietors. 
          It may be working capital, a line of credit, or a term loan granted to meet various investment or operational needs. 
          Unlike <strong>personal loans</strong>, the professional loan is specifically structured to align with your company's cash flows and business cycles, providing flexibility and terms tailored to real-world business conditions.
        </p>
      </div>
    </div>

    <div class="row align-items-center mb-5 feature-row" data-aos="fade-left" data-aos-duration="1000">
      <div class="col-md-6">
        <div class="ratio ratio-16x9 video-container shadow-sm rounded">
          <video loading="lazy" autoplay muted loop playsinline preload="metadata" 
            poster="{{asset('img/img16.jpg')}}" class="img-fluid rounded">
            <source src="{{asset('video/video11.mp4')}}" type="video/mp4">
            Your browser does not support the video tag.
          </video>
        </div>
      </div>
      <div class="col-md-6">
        <h3 class="feature-title text-accent-red mb-3">Why choose {{NAME_SITE}} for your Professional Loan?</h3>
        <p class="text-secondary-dark">
          At <span class="fw-bold">{{NAME_SITE}}</span>, we stand out through our commitment to being a true partner in your growth.
        </p>
        <ul class="list-unstyled">
          <li class="mb-2"><i class="fas fa-check-circle text-primary-dark me-2"></i> **Tailored Fit:** Solutions finely tuned to your project.</li>
          <li class="mb-2"><i class="fas fa-check-circle text-primary-dark me-2"></i> **Speed & Efficiency:** Streamlined processes for smooth disbursement.</li>
          <li class="mb-2"><i class="fas fa-check-circle text-primary-dark me-2"></i> **Expert Support:** Insightful guidance from our specialists.</li>
          <li class="mb-2"><i class="fas fa-check-circle text-primary-dark me-2"></i> **Total Transparency:** Complete clarity on loan terms.</li>
          <li class="mb-2"><i class="fas fa-check-circle text-primary-dark me-2"></i> **Flexibility:** Repayment options adapted to your business activity.</li>
        </ul>
      </div>
    </div>

    <div class="row mb-5" data-aos="fade-up" data-aos-duration="1000">
      <div class="col-lg-10 mx-auto text-center">
        <h3 class="feature-title text-accent-red mb-4">Who is this service for?</h3>
        <div class="row g-4 justify-content-center">
          <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 bg-light-blue">
              <div class="card-body text-center">
                <i class="fas fa-building fa-3x text-primary-dark mb-3"></i>
                <h5 class="card-title text-primary-dark">SMEs & Start‑ups</h5>
                <p class="card-text text-secondary-dark">Funding for growth and innovation.</p>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 bg-light-blue">
              <div class="card-body text-center">
                <i class="fas fa-user-tie fa-3x text-primary-dark mb-3"></i>
                <h5 class="card-title text-primary-dark">Entrepreneurs & Freelancers</h5>
                <p class="card-text text-secondary-dark">Support for your individual projects.</p>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 bg-light-blue">
              <div class="card-body text-center">
                <i class="fas fa-chart-line fa-3x text-primary-dark mb-3"></i>
                <h5 class="card-title text-primary-dark">Established Companies</h5>
                <p class="card-text text-secondary-dark">For expansion and diversification.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="row mb-5" data-aos="fade-up" data-aos-duration="1000">
      <div class="col-lg-10 mx-auto text-center">
        <h3 class="feature-title text-accent-red mb-4">How does it work? (Simplified process)</h3>
        <div class="process-steps">
          <div class="process-step" data-aos="zoom-in" data-aos-duration="800" data-aos-delay="100">
            <div class="step-icon bg-primary-dark text-white"><i class="fas fa-1"></i></div>
            <h5 class="step-title text-primary-dark">Initial Contact</h5>
            <p class="text-secondary-dark">Fill out our online application form.</p>
          </div>
          <div class="process-step" data-aos="zoom-in" data-aos-duration="800" data-aos-delay="200">
            <div class="step-icon bg-primary-dark text-white"><i class="fas fa-2"></i></div>
            <h5 class="step-title text-primary-dark">Personalized Analysis</h5>
            <p class="text-secondary-dark">Review of your project and financial situation.</p>
          </div>
          <div class="process-step" data-aos="zoom-in" data-aos-duration="800" data-aos-delay="300">
            <div class="step-icon bg-primary-dark text-white"><i class="fas fa-3"></i></div>
            <h5 class="step-title text-primary-dark">Tailored Proposal</h5>
            <p class="text-secondary-dark">Presentation of a detailed and transparent loan offer.</p>
          </div>
          <div class="process-step" data-aos="zoom-in" data-aos-duration="800" data-aos-delay="400">
            <div class="step-icon bg-primary-dark text-white"><i class="fas fa-4"></i></div>
            <h5 class="step-title text-primary-dark">Rapid Disbursement</h5>
            <p class="text-secondary-dark">Quick transfer of funds after document approval.</p>
          </div>
          <div class="process-step" data-aos="zoom-in" data-aos-duration="800" data-aos-delay="500">
            <div class="step-icon bg-primary-dark text-white"><i class="fas fa-5"></i></div>
            <h5 class="step-title text-primary-dark">Ongoing Support</h5>
            <p class="text-secondary-dark">Support from our team throughout the loan term.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="row" data-aos="fade-up" data-aos-duration="1000">
      <div class="col-lg-10 mx-auto">
        <h3 class="feature-title text-accent-red mb-4 text-center">Benefits for you:</h3>
        <div class="row g-4">
          <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 bg-primary-dark text-white text-center p-3">
              <div class="card-body">
                <i class="fas fa-rocket fa-2x mb-3 text-accent-red"></i>
                <h5 class="card-title">Accelerated Development</h5>
                <p class="card-text">Get the funds needed to invest, innovate, and seize new opportunities.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 bg-light-blue text-primary-dark text-center p-3">
              <div class="card-body">
                <i class="fas fa-cogs fa-2x mb-3 text-accent-red"></i>
                <h5 class="card-title">Operational Flexibility</h5>
                <p class="card-text">Manage your cash flow confidently with repayment terms tailored to your business.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 bg-primary-dark text-white text-center p-3">
              <div class="card-body">
                <i class="fas fa-bolt fa-2x mb-3 text-accent-red"></i>
                <h5 class="card-title">Simplicity & Speed</h5>
                <p class="card-text">Simplified procedures for fast access to financing.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 bg-light-blue text-primary-dark text-center p-3">
              <div class="card-body">
                <i class="fas fa-handshake fa-2x mb-3 text-accent-red"></i>
                <h5 class="card-title">Solid Partnership</h5>
                <p class="card-text">Benefit from the expertise and support of a committed financial institution.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 bg-primary-dark text-white text-center p-3">
              <div class="card-body">
                <i class="fas fa-shield-alt fa-2x mb-3 text-accent-red"></i>
                <h5 class="card-title">Financial Security</h5>
                <p class="card-text">Build your growth on solid and predictable financial foundations.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<section class="cta-section bg-white text-center py-5">
    <div class="container" data-aos="zoom-in" data-aos-duration="1000">
        <h2 class="fs-2 fw-bold text-primary-dark">Ready to propel your business?</h2>
        <p class="lead mt-3 text-secondary-dark">Contact us today to discuss your projects and get a tailored financing solution.</p>
        <a href="{{path('loan.application.credit')}}" class="btn btn-secondary-custom btn-lg mt-4">Apply for a loan</a>
    </div>
</section>
     </main>
{% endblock %}