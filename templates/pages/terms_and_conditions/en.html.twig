{% extends 'base.html.twig' %}
{% block title %}Terms and Conditions – {{NAME_SITE}}{% endblock %}
{% block meta_description %}
    Review the terms and conditions for using the services of {{NAME_SITE}}. Important information on access, use, and responsibilities.
{% endblock %}
{% block meta_keywords %}
    terms and conditions, general conditions, T&C, {{NAME_SITE}}, user agreement, usage rules, responsibility, intellectual property
{% endblock %}
{% block body %}
    <main class="professional-loan">
    <section class="hero-section hero-termes-conditions text-white d-flex align-items-center justify-content-center text-center">
    <div class="container" data-aos="fade-up" data-aos-duration="1000">
        <h1 class="display-3 fw-bold">General Terms and Conditions</h1>
        <p class="lead mt-3">Governing the use of {{NAME_SITE}}'s services and website.</p>
    </div>
</section>

 <section class="py-5 bg-white">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-md-12">
                <div class="mb-4" data-aos="fade-up" data-aos-duration="1000">
                    <p class="text-secondary-dark">
                        Welcome to the <strong>{{NAME_SITE}}</strong> website. Access to and use of our site, as well as all of our financial services, are subject to these General Terms and Conditions of Use and Sale (hereinafter "T&C"). By accessing and using this site, you acknowledge that you have read, understood, and agreed to be bound by these T&C, as well as by our Privacy Policy. If you do not agree to these T&C, please do not use our site or our services.
